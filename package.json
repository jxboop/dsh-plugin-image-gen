{
  "name": "@dsh-external/dsh-plugin-image-gen",
  "version": "1.3.0",
  "description": "把一条提示词变成图片：host 工具 image_generate（HF FLUX 无水印优先 / pollinations 兜底，落盘为附件）——手机桥的「生图」键就是调它",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build:local": "node scripts/build-local.mjs",
    "build": "bash scripts/build.sh",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "node scripts/build-local.mjs --check"
  }
}
